   "source": [
    "\n",
    "'''The activity 1: testing a simple while loop'''\n",
    "\n",
    "removed = 0\n",
    "\n",
    "print(\"How many cable should I remove?\\n\")\n",
    "cables = int(input(\"How many cables should I remove?\"))\n",
    "\n",
    "while removed < cables:\n",
    "    print(\"Removed cable.\")\n",
    "    removed = removed + 1\n"
   ]
