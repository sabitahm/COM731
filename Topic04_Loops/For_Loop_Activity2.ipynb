   "source": [
    "# Ask user for distance\n",
    "distance = int(input(\"How far are we from the cave?\"))\n",
    "\n",
    "for count in range(distance, 0, -1):\n",
    "    print(f\"{count} steps remaining\")\n",
    "\n",
    "print(\"We have reached the cave!\")\n"
   ]
  }
